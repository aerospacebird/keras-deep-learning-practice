import numpy as np
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Dense

#1. 데이터 
x = np.array(range(10)) # 0 부터 9까지 
print(x)

x = np.array(range(1, 10)) # [1 2 3 4 5 6 7 8 9]
print(x)

x = np.array([range(10), range(21, 31,), range(201, 211)]).T # [1 2 3 4 5 6 7 8 9]
print(x.shape) # (3, 10) -----> (10, 3)

y = np.array(range(1, 11))
print(y.shape)   #(10,)


#2. 모델 구성
model = Sequential()
model.add(Dense(3, input_dim=3))
model.add(Dense(7))
model.add(Dense(5))
model.add(Dense(3))
model.add(Dense(1))

#3. compile, trainging
model.compile(loss= 'mse', optimizer='adam')
model.fit(x, y, epochs= 1000)

#4. 평가 및 추론
loss = model.evaluate(x, y)
print('손실값 :', loss)

results = model.predict(np.array([[10, 31, 211]]))
print('추론값 : ', results)


